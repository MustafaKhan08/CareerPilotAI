# ==========================================================
# Database Configuration
# ==========================================================

DATABASE_URL=postgresql+psycopg://postgres:your_db_password@localhost:5432/careerpilotai

# ==========================================================
# JWT Configuration
# ==========================================================

SECRET_KEY=replace_with_a_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================================
# AI Provider Configuration (OpenAI-Compatible API)
# ==========================================================

# APINex endpoint (current provider)
# Replace with https://openrouter.ai/api/v1 if using OpenRouter
OPENROUTER_BASE_URL=https://api.apinex.bond/v1

# Add your actual API key only to your local .env file
OPENROUTER_API_KEYS=your_apinex_api_key

# Model identifier supported by your selected provider
AI_MODELS="free/gpt-6-luna"

# ==========================================================
# AI Generation Configuration
# ==========================================================

AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2500
AI_MAX_RETRIES=3

# ==========================================================
# AI Networking Configuration
# ==========================================================

AI_TIMEOUT=180
AI_CONNECT_TIMEOUT=10
AI_WRITE_TIMEOUT=30
AI_POOL_TIMEOUT=10

AI_MAX_CONNECTIONS=100
AI_MAX_KEEPALIVE=20

AI_BACKOFF_BASE_SECONDS=1

# ==========================================================
# Optional AI Provider Headers
# ==========================================================

OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=CareerPilotAI

USER_AGENT=CareerPilotAI/1.0

# ==========================================================
# NVIDIA Embedding Configuration
# ==========================================================

NVIDIA_PRIMARY_API_KEY=your_primary_nvidia_api_key

NVIDIA_FALLBACK_API_KEY=your_fallback_nvidia_api_key

NVIDIA_EMBEDDING_API_URL=https://integrate.api.nvidia.com/v1/embeddings

EMBEDDING_PROVIDER=nvidia

EMBEDDING_PRIMARY_MODEL=nvidia/nemotron-3-embed-1b

EMBEDDING_FALLBACK_MODEL=nvidia/llama-nemotron-embed-1b-v2

EMBEDDING_BATCH_SIZE=100

EMBEDDING_MAX_RETRIES=3

EMBEDDING_TIMEOUT=30

EMBEDDING_BACKOFF_BASE_SECONDS=1

EMBEDDING_STORAGE_DIRECTORY=data/embeddings

EMBEDDING_SIMILARITY_TOP_K=20