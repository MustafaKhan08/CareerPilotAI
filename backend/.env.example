# ==========================================================
# Database Configuration
# ==========================================================

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/careerpilotai

# ==========================================================
# JWT Configuration
# ==========================================================

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================================
# OpenRouter Configuration
# ==========================================================

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_API_KEYS=your_openrouter_key_1,your_openrouter_key_2,your_openrouter_key_3

AI_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ==========================================================
# AI Generation Configuration
# ==========================================================

AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2500
AI_MAX_RETRIES=3

# ==========================================================
# AI Networking Configuration
# ==========================================================

AI_TIMEOUT=60
AI_CONNECT_TIMEOUT=10
AI_WRITE_TIMEOUT=30
AI_POOL_TIMEOUT=10

AI_MAX_CONNECTIONS=100
AI_MAX_KEEPALIVE=20

AI_BACKOFF_BASE_SECONDS=1

# ==========================================================
# OpenRouter Optional Headers
# ==========================================================

OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=CareerPilotAI

USER_AGENT=CareerPilotAI/1.0

# ==========================================================
# NVIDIA Embedding Configuration
# ==========================================================

NVIDIA_PRIMARY_API_KEY=your_primary_embedding_api_key

NVIDIA_FALLBACK_API_KEY=your_fallback_embedding_api_key

NVIDIA_EMBEDDING_API_URL=https://integrate.api.nvidia.com/v1/embeddings

EMBEDDING_PROVIDER=nvidia

EMBEDDING_PRIMARY_MODEL=nvidia/nemotron-3-embed-1b

EMBEDDING_FALLBACK_MODEL=nvidia/llama-nemotron-embed-1b-v2

EMBEDDING_BATCH_SIZE=100

EMBEDDING_MAX_RETRIES=3

EMBEDDING_TIMEOUT=30

EMBEDDING_BACKOFF_BASE_SECONDS=1

EMBEDDING_STORAGE_DIRECTORY=data/embeddings

EMBEDDING_SIMILARITY_TOP_K=20